# ---- webflasher.sybilsight.com ---------------------------------------------
webflasher.sybilsight.com {
	import common

	@firmwareIndex path /firmware-updates/source-files/index.json
	header @firmwareIndex Cache-Control "no-cache"

	@releaseManifest path /release.json
	header @releaseManifest Cache-Control "no-store, max-age=0"
	@releaseCatalog path /firmware-catalog.json
	header @releaseCatalog Cache-Control "no-store, max-age=0"

	@appShell path / /index.html
	header @appShell Cache-Control "no-store, max-age=0"

	@builtAssets path /assets/*
	header @builtAssets Cache-Control "public, max-age=31536000, immutable"

	@firmwareFiles {
		path /firmware-updates/source-files/*
		not path /firmware-updates/source-files/index.json
	}
	header @firmwareFiles Cache-Control "public, max-age=31536000, immutable"

	handle /remote-support/ws {
		reverse_proxy local-sybilsight-remote-support:8787
	}
	handle /remote-support/healthz {
		rewrite * /healthz
		reverse_proxy local-sybilsight-remote-support:8787
	}
	# The release-bound catalog and bundled firmware are present in the
	# same atomic web-root swap as release.json. Keep older official binaries in
	# the larger shared archive without allowing a refresh to shadow these files.
	handle /firmware-updates/source-files/index.json {
		root * /share/webflasher
		file_server
	}
	handle /firmware-updates/source-files/2.0.1.14/* {
		root * /share/webflasher
		file_server
	}
	handle /firmware-updates/source-files/2.0.3.20/* {
		root * /share/webflasher
		file_server
	}
	handle /firmware-updates/source-files/2.0.5.12/* {
		root * /share/webflasher
		file_server
	}
	handle /firmware-updates/source-files/2.0.6.14/* {
		root * /share/webflasher
		file_server
	}
	handle /firmware-updates/source-files/2.0.7.16/* {
		root * /share/webflasher
		file_server
	}
	handle /firmware-updates/source-files/2.0.8.20/* {
		root * /share/webflasher
		file_server
	}
	handle /firmware-updates/source-files/2.0.9.20/* {
		root * /share/webflasher
		file_server
	}
	handle /firmware-updates/source-files/2.1.1.8/* {
		root * /share/webflasher
		file_server
	}
	handle /firmware-updates/source-files/2.1.1.12/* {
		root * /share/webflasher
		file_server
	}
	handle /firmware-updates/source-files/2.2.0.24/* {
		root * /share/webflasher
		file_server
	}
	handle /firmware-updates/source-files/2.2.4.34/* {
		root * /share/webflasher
		file_server
	}
	handle /firmware-updates/source-files/2.2.6.10/* {
		root * /share/webflasher
		file_server
	}
	handle /firmware-updates/source-files/2.2.6.11/* {
		root * /share/webflasher
		file_server
	}
	handle /firmware-updates/source-files/2.2.8.4/* {
		root * /share/webflasher
		file_server
	}
	handle /firmware-updates/source-files/2.2.8.9/* {
		root * /share/webflasher
		file_server
	}
	handle /firmware-updates/source-files/2.2.8.10/* {
		root * /share/webflasher
		file_server
	}
	handle /firmware-updates/source-files/2.2.8.11/* {
		root * /share/webflasher
		file_server
	}
	handle /firmware-updates/source-files/2.2.8.11-runtime-fix/* {
		root * /share/webflasher
		file_server
	}
	handle /firmware-updates/source-files/2.2.7.14/* {
		root * /share/webflasher
		file_server
	}
	# R1 Secure DFU packages are small, release-bound assets carried by the
	# WebFlasher build rather than the separate historical G2 archive.
	handle /firmware-updates/source-files/r1/* {
		root * /share/webflasher
		file_server
	}
	handle /firmware-updates/* {
		root * /share/sybilsight
		file_server
	}
	handle {
		root * /share/webflasher
		try_files {path} /index.html
		file_server
	}

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=(self)"
	}

	log {
		output file /share/caddy/logs/webflasher.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
