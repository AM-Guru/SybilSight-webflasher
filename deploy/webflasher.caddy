# ---- webflasher.sybilsight.com ---------------------------------------------
webflasher.sybilsight.com {
	import common

	@firmwareIndex path /firmware-updates/source-files/index.json
	header @firmwareIndex Cache-Control "no-cache"

	@releaseManifest path /release.json
	header @releaseManifest Cache-Control "no-store, max-age=0"
	@releaseCatalog path /firmware-catalog.json
	header @releaseCatalog Cache-Control "no-store, max-age=0"
	@appVersionManifest path /app-versions.json
	header @appVersionManifest Cache-Control "no-store, max-age=0"

	@appShell path / /index.html
	header @appShell Cache-Control "no-store, max-age=0"

	@builtAssets path /assets/*
	header @builtAssets Cache-Control "public, max-age=31536000, immutable"

	@firmwareFiles {
		path /firmware-updates/source-files/*
		not path /firmware-updates/source-files/index.json
	}
	header @firmwareFiles Cache-Control "public, max-age=31536000, immutable"

	handle /remote-support/ws {
		reverse_proxy local-sybilsight-remote-support:8787
	}
	handle /remote-support/healthz {
		rewrite * /healthz
		reverse_proxy local-sybilsight-remote-support:8787
	}
	# App releases are published independently of this site's atomic deploy.
	# Keep the ledger in persistent shared storage so a website release cannot
	# roll it back to the source-tree seed manifest.
	handle /app-versions.json {
		root * /share/sybilsight/app-releases
		file_server
	}
	# Prefer every release-bound firmware file carried by the atomic site
	# release. This file-existence matcher automatically covers new G2 archive
	# keys and R1 versions without requiring another Caddy route edit. Requests
	# absent from the release still fall through to the larger historical archive.
	@releaseFirmware {
		path /firmware-updates/source-files/*
		file {
			root /share/webflasher
		}
	}
	handle @releaseFirmware {
		root * /share/webflasher
		file_server
	}
	handle /firmware-updates/* {
		root * /share/sybilsight
		file_server
	}
	handle {
		root * /share/webflasher
		try_files {path} /index.html
		file_server
	}

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=(self)"
	}

	log {
		output file /share/caddy/logs/webflasher.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
